# Copy to .env. Keep actual credentials exclusively in .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/lifequest?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/lifequest?sslmode=require
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/lifequest_test
NODE_ENV=development
PORT=3333
WEB_ORIGIN=http://localhost:4200
ADMIN_ORIGIN=http://localhost:4201
APP_URL=http://localhost:4200
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
MAIL_MODE=development

# Required only for production email delivery. Never expose these to the browser.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SSR_ALLOWED_HOSTS=localhost,127.0.0.1

# Private persistent storage for optional feedback screenshots
UPLOAD_DIR=.local/uploads

# Optional Vercel deployment (private server configuration)
VERCEL_WEB_ORIGIN=
VERCEL_ADMIN_ORIGIN=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
# Set MAIL_MODE=disabled to run without verification/recovery email delivery.
