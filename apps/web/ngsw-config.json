{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "assetGroups": [
    {
      "name": "shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.csr.html",
          "/*.css",
          "/favicon.svg",
          "/icon-*.png",
          "/manifest.webmanifest"
        ]
      }
    },
    {
      "name": "application",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/*.js"] }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/api/**", "!/auth/**"],
  "dataGroups": []
}
